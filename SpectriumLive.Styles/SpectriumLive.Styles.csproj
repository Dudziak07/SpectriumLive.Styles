<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>

    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageId>SpectriumLive.Styles</PackageId>
    <Version>1.11.2</Version>
    <Authors>Filip Dudziec</Authors>
    <Company>Dudziak07</Company>
    <Description>Modern, lightweight, and reusable WPF style library with dark and light themes for .NET desktop applications.</Description>
    <PackageTags>wpf;styles;theme;dark-theme;light-theme;xaml;controls;ui;spectrium;dotnet</PackageTags>
    <PackageProjectUrl>https://github.com/Dudziak07/SpectriumLive.Styles</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Dudziak07/SpectriumLive.Styles</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReleaseNotes>Updated documentation, search tags, repository metadata and modern WPF styles for .NET 10.0.</PackageReleaseNotes>
    <PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Copyright>Copyright (c) 2025-2026 Filip Dudziec</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\LICENSE.txt" Pack="true" PackagePath="\"/>
    <None Include="..\README.md" Pack="true" PackagePath="\"/>
  </ItemGroup>

  <ItemGroup>
    <Compile Remove=".github\**" />
    <EmbeddedResource Remove=".github\**" />
    <None Remove=".github\**" />
    <Page Remove=".github\**" />
  </ItemGroup>

</Project>
